.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.DS_Store

# Репозиторий публичный, а медиа песен тяжёлые и невоспроизводимые.
# Поэтому whitelist: игнорируем в library/ всё, кроме текстов и meta.json.
# Перечислять расширения нельзя — на Linux (core.ignorecase=false) любой
# cover.JPG или новый .m4a утёк бы в коммит.
library/**
!library/**/
!library/**/*.md
!library/**/meta.json
library/**/raw/

# AI-конфиги провайдеров
.claude/

# Obsidian vault settings
.obsidian/
